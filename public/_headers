# Cloudflare Pages Caching & Security Headers
/data/ict-2025-replays/*
  Content-Type: application/json; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/ads.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/downloads/learnsmc-ict-smc-cheat-sheet-en.pdf
  Content-Type: application/pdf
  Link: <https://learnsmc.xyz/resources/ict-smc-cheat-sheet/>; rel="canonical"
  Cache-Control: public, max-age=3600

/downloads/learnsmc-ict-smc-cheat-sheet-ur.pdf
  Content-Type: application/pdf
  Link: <https://learnsmc.xyz/ur/resources/ict-smc-cheat-sheet/>; rel="canonical"
  Cache-Control: public, max-age=3600

/downloads/backtest-template.csv
  Content-Type: text/csv; charset=utf-8
  X-Robots-Tag: noindex

/resources/eurusd-bearish-breaker-practice.csv
  Content-Type: text/csv; charset=utf-8
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/articles/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
/resources/nq-silver-bullet-practice.csv
  Content-Type: text/csv; charset=utf-8
