{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ict-smc",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "src/worker.ts"
}
